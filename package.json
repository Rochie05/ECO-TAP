{
  "name": "eco-tap-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.mjs"
  },
  "dependencies": {
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
