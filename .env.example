# Copy this file to .env and fill it in. Never commit .env (it is already in .gitignore).
#
# Supabase dashboard -> Connect -> "Session pooler" connection string.
# If your password contains special characters (@ # / : ? %), URL-encode them
# (for example @ becomes %40), or reset it to letters and numbers only.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# --- Mobile kiosk app ---
# Shared secret the Android kiosk app sends as X-Kiosk-Key. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave empty to keep the kiosk API switched off.
KIOSK_API_KEY=
# The API listens on this machine only by default. To let a phone on the same Wi-Fi reach it,
# set this to 0.0.0.0 (and allow port 3000 through your firewall).
# API_HOST=0.0.0.0

# --- Deposits ---
# Kiosk station that deposits from the Android app are credited to (e.g. K-001). Leave empty to use
# the first station in the database; with no stations, deposits are still recorded as "KIOSK-APP".
# KIOSK_STATION_ID=
# Kilograms that equal a 100% full bin (used to update bin fill levels on every deposit). Default 50.
# BIN_CAPACITY_KG=50

# --- Machine (load cell + optical sensor) ---
# Per-station keys for the machine controller, as STATION:KEY pairs separated by commas. Only a request
# signed with a station's own key can log a deposit (POST /api/kiosk/device/deposit-event).
# Generate each key like the kiosk key above. Leave empty to switch machine deposits off.
# DEVICE_KEYS=K-001:longrandomvalue1,K-002:longrandomvalue2
