# Copy to .env. EXPO_PUBLIC_* values are compiled into the app, so treat the key as a device key, not a secret.
# Emulator, server on the same PC:  http://10.0.2.2:3000
# Real phone on the same Wi-Fi:      http://<your-PC-LAN-IP>:3000   (server needs API_HOST=0.0.0.0)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# Must equal KIOSK_API_KEY in the server's .env
EXPO_PUBLIC_KIOSK_KEY=
